<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/tvSheetTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="8dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Diente 11 · superficie V" />

    <LinearLayout
        android:id="@+id/btnEstadoSano"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">
        <View
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_odonto_swatch_sano" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Sano"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnEstadoCaries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">
        <View
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_odonto_swatch_caries" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Caries"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnEstadoObturado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">
        <View
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_odonto_swatch_obturado" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Obturado"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnEstadoAusente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">
        <View
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_odonto_swatch_ausente" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Ausente"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnEstadoExtraccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">
        <View
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_odonto_swatch_extraccion" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Extracción indicada"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnEstadoCorona"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">
        <View
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_odonto_swatch_corona" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Corona"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
